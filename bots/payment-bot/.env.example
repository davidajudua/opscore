# Payment Bot: IMAP monitor for Zelle, Venmo and PayPal, plus the ledger and /crypto
# Per-bot secrets only. Shared platform settings live in <repo-root>/.env.

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_PAYMENT_CHANNEL_ID=
# Channel where /refund requests are posted. Anyone who can see it can approve or
# deny them, so make it visible to admins only.
REFUND_CHANNEL_ID=

# Admin role allowed to run /dashboard, /cashout, /minus, /purge and the dashboard's
# Restart, Lock and Unlock buttons
ADMIN_ROLE_NAME=owner

# Gmail IMAP: one address + app password per rail (any can be omitted to disable
# that rail). The bot warns at startup if all three are empty.
GMAIL_ADDRESS_ZELLE=
GMAIL_APP_PASSWORD_ZELLE=
GMAIL_ADDRESS_VENMO=
GMAIL_APP_PASSWORD_VENMO=
GMAIL_ADDRESS_PAYPAL=
GMAIL_APP_PASSWORD_PAYPAL=

# Crypto receiving addresses for /crypto: a pasted transaction is booked only if it
# paid one of these. Any can be blank to disable that chain. CRYPTO_ADDRESS_ETH also
# covers BSC, Base, Arbitrum and Polygon.
CRYPTO_ADDRESS_BTC=
CRYPTO_ADDRESS_ETH=
CRYPTO_ADDRESS_LTC=
CRYPTO_ADDRESS_SOL=
CRYPTO_ADDRESS_TRX=
