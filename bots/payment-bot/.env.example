# Payment Bot — IMAP monitor for Zelle/Venmo/PayPal + ledger + crypto checker
# Per-bot secrets only — shared platform settings live in <repo-root>/.env.

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_PAYMENT_CHANNEL_ID=
REFUND_CHANNEL_ID=

# Admin role allowed to run /dashboard, /cashout, /refund, /crypto, /minus, /purge
ADMIN_ROLE_NAME=

# Gmail IMAP — one address + app password per provider (any can be omitted to
# disable that provider). The bot warns at startup if all three are empty.
GMAIL_ADDRESS_ZELLE=
GMAIL_APP_PASSWORD_ZELLE=
GMAIL_ADDRESS_VENMO=
GMAIL_APP_PASSWORD_VENMO=
GMAIL_ADDRESS_PAYPAL=
GMAIL_APP_PASSWORD_PAYPAL=

# IMAP poll cadence in ms (default 30000 = 30s)
POLL_INTERVAL_MS=

# Crypto receiving addresses for /crypto manual entry — any can be blank to
# disable that chain.
CRYPTO_ADDRESS_BTC=
CRYPTO_ADDRESS_ETH=
CRYPTO_ADDRESS_LTC=
CRYPTO_ADDRESS_SOL=