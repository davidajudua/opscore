# Code Bot: one-time code queue for Amex SafeKey and Capital One (Eno) codes
# Per-bot secrets only. Shared platform settings live in <repo-root>/.env.
#
# Sender filters, subject patterns and code patterns are in src/imap-fetcher.js
# (Amex), src/eno-fetcher.js (Capital One) and src/webhook-fetcher.js (SMS webhook).
# Edit them there if an email format changes.

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Proton Mail Bridge IMAP. The host, port and folder below are the Bridge's
# defaults for a Bridge running on the same machine.
PROTON_IMAP_USER=
PROTON_IMAP_PASS=
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
MAIL_FOLDER=INBOX

# Optional second source for SafeKey codes: a Discord channel where an SMS
# forwarder's webhook posts the texts. Set both to enable it. With either one
# missing, the bot reads the mailbox only.
# CHANNEL_ID is the channel the webhook posts in. AUTHOR_ID is the webhook's user id.
WEBHOOK_CODE_CHANNEL_ID=
WEBHOOK_CODE_AUTHOR_ID=
