# Code Bot — Safekey verification code fetcher
# Per-bot secrets only — shared platform settings live in <repo-root>/.env.
#
# Sender filter, subject regex, and code regex are hardcoded in
# src/imap-fetcher.js — edit there if the email format changes.

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Proton Bridge IMAP (defaults work for a local Bridge install)
PROTON_IMAP_USER=
PROTON_IMAP_PASS=
PROTON_IMAP_HOST=
PROTON_IMAP_PORT=
MAIL_FOLDER=

# Discord-channel webhook fallback for SafeKey codes (optional)
# Both must be set together to enable; if either is missing, IMAP-only mode.
# CHANNEL_ID = channel where the SMS-forwarder webhook posts codes.
# AUTHOR_ID  = the user/app ID of that webhook.
WEBHOOK_CODE_CHANNEL_ID=
WEBHOOK_CODE_AUTHOR_ID=
