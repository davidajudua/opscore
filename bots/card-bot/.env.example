# Card Bot: card pool + /card claim flow
# Per-bot secrets only. Shared platform settings live in <repo-root>/.env.

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Admin role allowed to run /load, /export, /whitelist, /providers, /stats, /setprice, /purge
ADMIN_ROLE_NAME=owner

# Seals every stored card (AES-256-GCM). Required: the bot refuses to start without it.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back it up somewhere other than this server. Without it the stored cards cannot be opened.
CARD_ENCRYPTION_KEY=
