{
  "name": "bot-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Discord bots for internal operations that share one Node core and run under PM2.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "bots/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm test -w @platform/bot-core",
    "dev:code": "npm run dev -w code-bot",
    "dev:payment": "npm run dev -w payment-bot",
    "dev:card": "npm run dev -w card-bot",
    "start": "pm2 startOrReload pm2.config.cjs --update-env",
    "stop": "pm2 stop pm2.config.cjs",
    "restart": "pm2 restart pm2.config.cjs",
    "logs": "pm2 logs",
    "status": "pm2 status"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "^9.13.0",
    "globals": "^14.0.0"
  }
}
